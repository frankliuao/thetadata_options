# ThetaData v3 API Key (Obtain from https://thetadata.net user portal)
# Standard or Pro tier required for historical Greeks and Open Interest
THETADATA_API_KEY="your_thetadata_api_key_here"

# Default concurrency limit (Standard Tier = 4, Pro Tier = 8, Value Tier = 2)
THETADATA_MAX_WORKERS=4

# Optional: Google Drive folder ID for automated Parquet cloud sync
# Leave blank or omit to disable Google Drive sync
GDRIVE_FOLDER_ID=""

# Optional: Google Sheet ID for custom universe definition
# Defaults to the bundled config/sp500_universe.csv
SP500_UNIVERSE_SHEET_ID=""
